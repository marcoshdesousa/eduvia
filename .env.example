# ── Banco de dados (PostgreSQL 16 com pgvector) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduvia"

# ── App ──
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-longo"

# ── IA ──
# Sem ANTHROPIC_API_KEY o app roda em modo de demonstração (IA simulada, sem custo).
ANTHROPIC_API_KEY=""
# Modelo padrão e por tarefa (outline, edital, session, grade, ocr). Padrão: claude-opus-5-5
# AI_MODEL_DEFAULT="claude-opus-5-5"
# AI_MODEL_GRADE="claude-haiku-4-5"
# Embeddings (busca nos materiais). Sem chave, usa vetores locais simples.
VOYAGE_API_KEY=""

# ── Arquivos ──
# local (disco, só para desenvolvimento) ou s3 (S3, Cloudflare R2, MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
MAX_UPLOAD_MB=100
# S3_ENDPOINT="https://<conta>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="eduvia"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── Assinatura (manual, pelo WhatsApp) ──
# Número que recebe os pedidos: DDI + DDD + número, só dígitos. (Número de teste abaixo.)
WHATSAPP_NUMBER="5511999999999"
# false = ninguém cai no modo limitado após o teste de 3 dias (útil só em desenvolvimento)
BILLING_ENFORCED="true"
