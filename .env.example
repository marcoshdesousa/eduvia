# ── Banco de dados (PostgreSQL 16) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/horalimp"

# ── App ──
APP_URL="http://localhost:3000"
# gere com: openssl rand -base64 32 (também criptografa CPF e WhatsApp: não troque depois de ter contas)
BETTER_AUTH_SECRET="troque-por-um-segredo-longo"

# CPF do dono: a conta de cliente criada (ou que entrar) com este CPF vira administradora
ADMIN_CPF=""

# ── Arquivos (fotos e áudios) ── local (disco) ou s3 (S3/Cloudflare R2)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
# S3_BUCKET="" S3_REGION="auto" S3_ENDPOINT="" S3_ACCESS_KEY_ID="" S3_SECRET_ACCESS_KEY=""

# ── Pix da assinatura do profissional (SyncPay) ──
SYNCPAY_CLIENT_ID=""
SYNCPAY_CLIENT_SECRET=""
