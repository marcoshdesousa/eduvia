# ── Banco de dados (PostgreSQL 16 com pgvector) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduvia"

# ── App ──
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-longo"

# ── IA (Google Gemini com a chave de cada aluno) ──
# A plataforma não paga IA: cada aluno cola a própria chave do Gemini no cadastro (aistudio.google.com/apikey).
# mock = IA simulada, aceita qualquer chave (só para desenvolvimento e testes automáticos).
AI_MODE=""
# Segredo para criptografar as chaves dos alunos (padrão: BETTER_AUTH_SECRET). Trocar invalida as chaves salvas.
# AI_KEY_SECRET=""
# Modelos tentados em ordem (a cota grátis do Google é separada por modelo).
# GEMINI_MODELS="gemini-2.5-flash,gemini-2.5-flash-lite"
# GEMINI_MODEL_TUTOR="gemini-2.5-flash-lite"
# Embeddings (busca nos materiais). Sem chave, usa vetores locais simples (sem custo).
VOYAGE_API_KEY=""

# ── Processamento em segundo plano ──
# true = o worker roda dentro do app web (um só serviço). false = rode `npm run worker` separado.
RUN_WORKER_IN_WEB="false"

# ── Arquivos ──
# local (disco do servidor — no Render, um disco persistente) ou s3 (S3, Cloudflare R2, MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
MAX_UPLOAD_MB=100
# S3_ENDPOINT="https://<conta>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="eduvia"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── Assinatura (manual, pelo WhatsApp) ──
# Número que recebe os pedidos: DDI + DDD + número, só dígitos.
WHATSAPP_NUMBER="5562992097369"
# false = todo mundo tem o plano pago liberado (útil só em desenvolvimento)
BILLING_ENFORCED="true"

# ── Notificações push (celular/navegador) ──
# Gere uma vez com: npx web-push generate-vapid-keys
# Sem as chaves, as notificações ficam só na central do app (sino).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# e-mail de contato (mailto:) ou a URL https do app
VAPID_SUBJECT="mailto:suporte@eduvia.app"

# Voz das aulas (Google Cloud Text-to-Speech, voz Chirp 3 HD Kore): grava todas as aulas uma vez e guarda no disco.
# GOOGLE_TTS_API_KEY=""
# GOOGLE_TTS_MAX_CHARS_MONTH=950000
