# ── Banco de dados (PostgreSQL 16 com pgvector) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduvia"

# ── App ──
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-longo"

# ── Login com Google (opcional) ──
# Console Google Cloud → Credenciais → ID do cliente OAuth (aplicativo da Web)
# URI de redirecionamento autorizado: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── IA ──
# Sem ANTHROPIC_API_KEY o app roda em modo de demonstração (IA simulada, sem custo).
ANTHROPIC_API_KEY=""
# Modelo padrão e por tarefa (outline, edital, session, grade, ocr). Padrão: claude-opus-5-5
# AI_MODEL_DEFAULT="claude-opus-5-5"
# AI_MODEL_GRADE="claude-haiku-4-5"
# Embeddings (busca nos materiais). Sem chave, usa vetores locais simples.
VOYAGE_API_KEY=""

# ── Arquivos ──
# local (disco, só para desenvolvimento) ou s3 (S3, Cloudflare R2, MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
MAX_UPLOAD_MB=100
# S3_ENDPOINT="https://<conta>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="eduvia"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── E-mail (lembretes, redefinição de senha, consentimento) ──
# Sem SMTP_URL os e-mails aparecem no console.
# SMTP_URL="smtps://usuario:senha@smtp.resend.com:465"
# MAIL_FROM="Eduvia <nao-responda@seudominio.com>"

# ── Cobrança ──
# true = após os 3 dias de teste, sem assinatura o app redireciona para /assinatura
BILLING_ENFORCED="false"
