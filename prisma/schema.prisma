// Diária Paga — plataforma de serviços por diária (diarista, pedreiro, cuidador, babá, motorista, eletricista…).
// Quem contrata usa de graça. Quem oferece serviço paga um plano mensal (Básico R$ 6,85 ou Completo R$ 15,85).
// O serviço é pago direto ao prestador (dinheiro, Pix ou cartão dele): a Diária Paga não recebe esse valor.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Contas ─────────────────────────

enum Role {
  USER
  ADMIN
}

/// Toda conta pode contratar. Quem também oferece serviço tem um ProviderProfile.
model User {
  id            String   @id
  name          String
  /// e-mail técnico interno exigido pelo Better Auth (aleatório; nunca exibido nem usado)
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role            Role      @default(USER)
  cpfHash         String    @unique
  cpfSealed       String
  blockedAt       DateTime?
  blockReason     String?
  acceptedTermsAt DateTime  @default(now())
  /// código do link de indicação ("/convite/CODIGO")
  refCode         String?   @unique
  /// quem indicou esta conta
  referredById    String?
  referredBy      User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]    @relation("Referrals")

  sessions       Session[]
  accounts       Account[]
  provider       ProviderProfile?
  addresses      Address[]
  clientBookings Booking[]              @relation("ClientBookings")
  favorites      Favorite[]
  messages       Message[]
  conversations  Conversation[]         @relation("ClientConversations")
  reviewsGiven   Review[]               @relation("ReviewAuthor")
  reviewsGot     Review[]               @relation("ReviewTarget")
  reports        Report[]               @relation("Reporter")
  reportedIn     Report[]               @relation("Reported")
  blocks         Block[]                @relation("Blocker")
  blockedBy      Block[]                @relation("Blocked")
  tickets        SupportTicket[]
  notifications  Notification[]
  pushSubs       PushSubscription[]
  statusChanges  BookingStatusHistory[]
  auditLogs      AuditLog[]
  resets         PasswordReset[]
  payments       Payment[]

  @@index([createdAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String
  createdAt DateTime  @default(now())
}

/// Registro permanente por CPF (fica mesmo se a conta for apagada): teste grátis já usado e penalidade do cliente.
model CpfLedger {
  cpfHash          String    @id
  trialStartedAt   DateTime?
  /// cliente que não estava no endereço no Contrate rápido: fica sem contratar até esta data (ou paga a taxa)
  clientBlockedUntil DateTime?
  clientBlockReason  String?
  updatedAt        DateTime  @updatedAt
}

// ───────────────────────── Prestador ─────────────────────────

enum ProviderStatus {
  ACTIVE
  SUSPENDED
}

enum Plan {
  BASIC
  FULL
}

model ProviderProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate      DateTime?      @db.Date
  /// telefone (criptografado): só a plataforma vê (verificação e cobrança Pix); nunca aparece no app
  phoneSealed    String
  photoKey       String?
  bio            String?
  instagram      String?
  status         ProviderStatus @default(ACTIVE)
  statusReason   String?
  /// pausa: some da vitrine e do Contrate rápido
  paused         Boolean        @default(false)
  /// recebe chamados do Contrate rápido agora (botão "Disponível")
  quickOn        Boolean        @default(false)
  /// não aceitou e não chegou em 2 horas: fica fora do Contrate rápido até esta data
  quickBannedUntil DateTime?
  /// quando aceitou as regras do Contrate rápido (preço fixo, 2 horas, penalidades). Sem isso não recebe chamados.
  quickTermsAt   DateTime?
  /// formas de pagamento aceitas: PIX, DINHEIRO, DEBITO, CREDITO
  payMethods     String[]       @default(["PIX", "DINHEIRO"])
  /// false = o cliente não pede direto: manda mensagem e o prestador agenda pela conversa
  directBooking  Boolean        @default(true)
  /// indicações contam a partir daqui (o desconto zera quando é usado numa mensalidade)
  referralsFrom  DateTime       @default(now())
  quickReplies   QuickReply[]
  ratingSum      Int            @default(0)
  ratingCount    Int            @default(0)
  completedCount Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  services     ProviderService[]
  places       ProviderPlace[]
  availability AvailabilityRule[]
  posts        Post[]
  bookings     Booking[]
  favoritedBy  Favorite[]
  subscription Subscription?
  offers       QuickOffer[]
  conversations Conversation[]
  agenda       AgendaEntry[]
  finance      FinanceEntry[]

  @@index([status])
}

enum PriceUnit {
  DIARIA
  HORA
  SERVICO
}

/// Um serviço que o prestador oferece (categoria + preço + unidade).
model ProviderService {
  id          String          @id @default(cuid())
  proId       String
  pro         ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  category    String
  priceCents  Int
  unit        PriceUnit       @default(DIARIA)
  description String?
  /// cada serviço é um "perfil" do trabalhador (um por profissão), com foto, bio, fotos e links próprios
  photoKey    String?
  bio         String?
  instagram   String?
  website     String?
  posts       Post[]
  createdAt   DateTime        @default(now())

  @@unique([proId, category])
  @@index([category, priceCents])
}

/// Endereço do prestador no mapa (de onde ele é "puxado" para quem está perto). Básico: 1; Completo: 3 + pacotes.
model ProviderPlace {
  id       String          @id @default(cuid())
  proId    String
  pro      ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  label    String
  district String?
  city     String
  uf       String
  lat      Float
  lng      Float
  /// fora do limite do plano (ex.: voltou para o Básico): fica guardado, mas não conta
  active   Boolean         @default(true)
  createdAt DateTime       @default(now())

  @@index([uf, city])
  @@index([lat, lng])
}

model AvailabilityRule {
  id       String          @id @default(cuid())
  proId    String
  pro      ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int

  @@index([proId, weekday])
}

/// Foto do portfólio (até 8 por prestador).
model Post {
  id        String          @id @default(cuid())
  proId     String
  pro       ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  /// perfil (profissão) em que a foto aparece
  serviceId String?
  service   ProviderService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  imageKey  String
  caption   String?
  createdAt DateTime        @default(now())

  @@index([proId, createdAt])
  @@index([createdAt])
}

// ───────────────────────── Planos e pagamentos (Pix SyncPay) ─────────────────────────

model Subscription {
  id               String          @id @default(cuid())
  proId            String          @unique
  pro              ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  /// plano em vigor e pacotes de +2 endereços (só no Completo)
  plan             Plan            @default(FULL)
  packs            Int             @default(0)
  /// o que vale a partir da próxima cobrança (mudança de plano ou retirada de pacotes)
  nextPlan         Plan?
  nextPacks        Int?
  trial            Boolean         @default(false)
  currentPeriodEnd DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum PaymentKind {
  SUBSCRIPTION
  UPGRADE
  UNLOCK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        PaymentKind
  amountCents Int
  status      PaymentStatus @default(PENDING)
  /// "SYNCPAY" (Pix) ou "MANUAL" (liberado pelo admin)
  provider    String        @default("SYNCPAY")
  providerId  String?       @unique
  pixCode     String?
  /// o que este pagamento libera (plano, pacotes, período)
  meta        Json?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ProviderEvent {
  id        String   @id @default(cuid())
  provider  String
  eventKey  String   @unique
  payload   Json
  createdAt DateTime @default(now())
}

// ───────────────────────── Contratação ─────────────────────────

/// Endereços salvos do cliente.
model Address {
  id         String   @id @default(cuid())
  clientId   String
  client     User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label      String
  cep        String?
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  uf         String
  lat        Float?
  lng        Float?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([clientId, lastUsedAt])
}

enum BookingMode {
  NORMAL
  QUICK
}

enum BookingStatus {
  /// agendamento criado pelo prestador na conversa: horário reservado, falta o cliente confirmar com o endereço
  PROPOSED
  SEARCHING
  NO_PROVIDER
  WAITING_PRO
  ACCEPTED
  REFUSED
  EXPIRED
  ON_THE_WAY
  ARRIVED
  STARTED
  COMPLETED
  CANCELED_CLIENT
  CANCELED_PRO
  NO_SHOW_PRO
  NO_SHOW_CLIENT
  IN_REVIEW
}

model Booking {
  id            String           @id @default(cuid())
  mode          BookingMode      @default(NORMAL)
  clientId      String
  client        User             @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  /// no Contrate rápido fica vazio até alguém aceitar
  proId         String?
  pro           ProviderProfile? @relation(fields: [proId], references: [id], onDelete: Cascade)
  status        BookingStatus
  category      String
  unit          PriceUnit
  quantity      Int
  unitPriceCents Int?
  estimateCents Int?
  /// Contrate rápido: o máximo que o cliente quer gastar
  maxCents      Int?
  /// valor que o prestador informou ter recebido ao concluir (vai para o financeiro dele)
  finalCents    Int?
  scheduledAt   DateTime
  /// Contrate rápido: precisa chegar até aqui (2 horas depois do aceite)
  arriveBy      DateTime?
  notes         String?
  addrStreet     String
  addrNumber     String?
  addrComplement String?
  addrDistrict   String?
  addrCity       String
  addrUf         String
  addrCep        String?
  addrReference  String?
  lat            Float?
  lng            Float?
  payMethod     String?
  expiresAt     DateTime?
  acceptedAt    DateTime?
  arrivedAt     DateTime?
  completedAt   DateTime?
  canceledAt    DateTime?
  cancelReason  String?
  addressPurgedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  history  BookingStatusHistory[]
  messages Message[]
  reviews  Review[]
  reports  Report[]
  offers   QuickOffer[]

  @@index([clientId, createdAt])
  @@index([proId, status, scheduledAt])
  @@index([status, expiresAt])
  @@index([mode, status])
}

enum OfferState {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  LOST
}

/// Chamado do Contrate rápido enviado para um prestador (toca no celular dele).
model QuickOffer {
  id          String          @id @default(cuid())
  bookingId   String
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proId       String
  pro         ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  wave        Int
  distanceKm  Float
  priceCents  Int
  state       OfferState      @default(PENDING)
  sentAt      DateTime        @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@unique([bookingId, proId])
  @@index([proId, state, expiresAt])
}

model BookingStatusHistory {
  id        String         @id @default(cuid())
  bookingId String
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  from      BookingStatus?
  to        BookingStatus
  byUserId  String?
  by        User?          @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  reason    String?
  createdAt DateTime       @default(now())

  @@index([bookingId, createdAt])
}

enum MessageKind {
  /// cartão de agendamento (aponta para o pedido)
  SCHEDULE
  TEXT
  AUDIO
  IMAGE
  VIDEO
}

/// Conversa entre um cliente e um prestador (estilo WhatsApp). Pode começar antes de contratar.
model Conversation {
  id            String          @id @default(cuid())
  clientId      String
  client        User            @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  proId         String
  pro           ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  messages      Message[]

  @@unique([clientId, proId])
  @@index([proId, lastMessageAt])
  @@index([clientId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// pedido citado (cartão de agendamento)
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  senderId    String
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind        MessageKind
  text        String?
  fileKey     String?
  mime        String?
  durationSec Int?
  readAt      DateTime?
  editedAt    DateTime?
  /// apagada por quem mandou (some para os dois)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([conversationId, createdAt])
}

model Favorite {
  clientId  String
  client    User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proId     String
  pro       ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@id([clientId, proId])
}

model Review {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User      @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String?
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([bookingId, authorId])
  @@index([targetId, createdAt])
}

// ───────────────────────── Segurança, suporte e avisos ─────────────────────────

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String?
  target     User?        @relation("Reported", fields: [targetId], references: [id], onDelete: SetNull)
  bookingId  String?
  booking    Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messageId  String?
  reviewId   String?
  postId     String?
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

model Block {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  bookingId String?
  status    TicketStatus     @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean       @default(false)
  authorId  String
  text      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Compromisso que o prestador coloca na própria agenda (bloqueia o horário e gera lembrete).
model AgendaEntry {
  id        String          @id @default(cuid())
  proId     String
  pro       ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  title     String
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  createdAt DateTime        @default(now())

  @@index([proId, startsAt])
}

enum FinanceKind {
  IN
  OUT
}

/// Lançamento manual da gestão financeira do prestador (os serviços concluídos entram sozinhos).
model FinanceEntry {
  id          String          @id @default(cuid())
  proId       String
  pro         ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  kind        FinanceKind
  amountCents Int
  description String
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now())

  @@index([proId, date])
}

/// Mensagens rápidas que o trabalhador cadastra para mandar com um toque.
model QuickReply {
  id        String          @id @default(cuid())
  proId     String
  pro       ProviderProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime        @default(now())

  @@index([proId, createdAt])
}
