// Eduvia — schema da Fase 1 (MVP) + estrutura mínima de assinatura (teste grátis).
// Tabelas das fases 2 e 3 entram em migrações próprias.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Contas (Better Auth + campos do Eduvia) ─────────────────────────

enum ConsentStatus {
  NOT_REQUIRED
  PENDING
  GRANTED
  REVOKED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  handle                String?       @unique
  /// CPF (só dígitos): identifica a conta, login e redefinição de senha.
  cpf                   String?       @unique
  /// Telefone/WhatsApp (só dígitos, com DDD).
  phone                 String?
  isAdmin               Boolean       @default(false)
  remindersEnabled      Boolean       @default(true)
  birthDate             DateTime?     @db.Date
  guardianConsentStatus ConsentStatus @default(NOT_REQUIRED)
  profileVisibility     Visibility    @default(PUBLIC)
  timezone              String        @default("America/Sao_Paulo")
  termsAcceptedAt       DateTime?
  termsVersion          String?
  trialEndsAt           DateTime?
  billingCustomerId     String?
  /// Chave da API do Gemini do aluno, criptografada (AES-256-GCM). Obrigatória para usar a IA.
  geminiKey             String?
  /// Últimos caracteres da chave, para o aluno reconhecer qual está usando.
  geminiKeyHint         String?
  geminiConnectedAt     DateTime?
  /// A IA do aluno pediu pausa (cota do Google) até este horário.
  aiPausedUntil         DateTime?
  /// Foto de perfil: um dos personagens de /public/avatars (ex.: "gata").
  avatar                String?

  xp            Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime? @db.Date

  sessions         Session[]
  accounts         Account[]
  supportMessages  SupportMessage[]
  supportTickets   SupportTicket[]
  guardianConsents GuardianConsent[]
  preparations     Preparation[]
  materials        Material[]
  studySessions    StudySession[]
  attempts         Attempt[]
  reviewItems      ReviewItem[]
  topicReviews     TopicReview[]
  topicMastery     TopicMastery[]
  xpEvents         XpEvent[]
  studyDays        StudyDay[]
  subscriptions    Subscription[]
  aiUsage          AiUsage[]
  gameRuns         GameRun[]
  exams            Exam[]
  examAttempts     ExamAttempt[]
  essays           Essay[]
  tutorThreads     TutorThread[]
  groupsOwned      Group[]
  memberships      GroupMember[]
  invitesReceived  GroupInvite[]      @relation("invitee")
  invitesSent      GroupInvite[]      @relation("inviter")
  groupShares      GroupShare[]
  groupMessages    GroupMessage[]
  achievements     UserAchievement[]
  notifications    Notification[]
  pushSubs         PushSubscription[]
  usageCounters    UsageCounter[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model GuardianConsent {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianName  String
  guardianEmail String
  token         String    @unique
  grantedAt     DateTime?
  grantedIp     String?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────── Preparações e materiais ─────────────────────────

enum StudentType {
  FUNDAMENTAL
  MEDIO
  ENEM_VESTIBULAR
  FACULDADE
  CONCURSO
  CURSINHO
  LIVRE
}

enum PreparationStatus {
  ACTIVE
  ARCHIVED
}

model Preparation {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  studentType     StudentType
  details         Json              @default("{}")
  examDate        DateTime?         @db.Date
  dailyMinutes    Int
  studyDays       Int[]
  studyTime       String
  reviewIntervals Int[]             @default([1, 7, 15, 30])
  status          PreparationStatus @default(ACTIVE)
  lastReplanDate  DateTime?         @db.Date
  lastReminderAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  subjects       Subject[]
  materials      Material[]
  plans          StudyPlan[]
  editalAnalysis EditalAnalysis?
  gameRuns       GameRun[]
  exams          Exam[]
  essays         Essay[]
  tutorThreads   TutorThread[]

  @@index([userId, status])
}

enum TopicSource {
  EDITAL
  MATERIAL
  MANUAL
}

model Subject {
  id            String      @id @default(cuid())
  preparationId String
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  name          String
  weight        Float       @default(1)
  order         Int         @default(0)
  /// Livros recomendados pela IA (gerados junto com o índice do material): [{ title, author }]
  books         Json?
  createdAt     DateTime    @default(now())

  topics    Topic[]
  materials Material[]

  @@unique([preparationId, name])
}

model Topic {
  id               String      @id @default(cuid())
  subjectId        String
  subject          Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  order            Int         @default(0)
  weight           Float       @default(1)
  difficulty       Int         @default(3)
  estimatedMinutes Int         @default(30)
  source           TopicSource @default(MATERIAL)
  materialId       String?
  pageStart        Int?
  pageEnd          Int?
  createdAt        DateTime    @default(now())

  chunks          TopicChunk[]
  studyTexts      StudyText[]
  questions       Question[]
  plannedSessions PlannedSession[]
  studySessions   StudySession[]
  topicReviews    TopicReview[]
  mastery         TopicMastery[]

  @@index([subjectId])
}

enum MaterialKind {
  PDF
  DOCX
  IMAGE
  TEXT
}

enum MaterialRole {
  CONTENT
  EDITAL
  EMENTA
}

enum MaterialStatus {
  UPLOADING
  QUEUED
  PROCESSING
  READY
  ERROR
}

/// Arquivo físico identificado pelo hash: o mesmo arquivo é processado uma única vez.
model MaterialBlob {
  id          String    @id @default(cuid())
  sha256      String?   @unique
  storageKey  String
  mimeType    String
  sizeBytes   Int
  pageCount   Int?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  materials Material[]
  pages     MaterialPage[]
  chunks    Chunk[]
}

model Material {
  id            String         @id @default(cuid())
  preparationId String
  preparation   Preparation    @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  subjectId     String?
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  uploaderId    String
  uploader      User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  blobId        String?
  blob          MaterialBlob?  @relation(fields: [blobId], references: [id])
  title         String
  kind          MaterialKind
  role          MaterialRole   @default(CONTENT)
  status        MaterialStatus @default(UPLOADING)
  progressStep  String?
  errorMessage  String?
  /// Tentativas automáticas (cota da IA, instabilidade): o aluno não vê erro enquanto tentamos de novo.
  autoRetries   Int      @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([preparationId])
}

model MaterialPage {
  id         String       @id @default(cuid())
  blobId     String
  blob       MaterialBlob @relation(fields: [blobId], references: [id], onDelete: Cascade)
  pageNumber Int
  text       String
  ocr        Boolean      @default(false)

  @@unique([blobId, pageNumber])
}

model Chunk {
  id         String                       @id @default(cuid())
  blobId     String
  blob       MaterialBlob                 @relation(fields: [blobId], references: [id], onDelete: Cascade)
  index      Int
  content    String
  pageStart  Int
  pageEnd    Int
  tokenCount Int
  embedding  Unsupported("vector(1024)")?

  topics TopicChunk[]

  @@unique([blobId, index])
}

model TopicChunk {
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  chunkId String
  chunk   Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  score   Float  @default(1)

  @@id([topicId, chunkId])
  @@index([chunkId])
}

model EditalAnalysis {
  id            String      @id @default(cuid())
  preparationId String      @unique
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  banca         String?
  cargo         String?
  questionStyle String      @default("MULTIPLA_ESCOLHA")
  raw           Json
  createdAt     DateTime    @default(now())
}

// ───────────────────────── Plano e sessões ─────────────────────────

enum Feasibility {
  OK
  APERTADO
  INSUFICIENTE
}

enum SessionKind {
  STUDY
  REVIEW
  PRACTICE
}

enum PlannedStatus {
  PENDING
  DONE
  MISSED
  SKIPPED
}

model StudyPlan {
  id             String      @id @default(cuid())
  preparationId  String
  preparation    Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  version        Int
  feasibility    Feasibility
  totalMinutes   Int
  capacityMinutes Int
  missingMinutes Int         @default(0)
  notes          String?
  createdAt      DateTime    @default(now())

  sessions PlannedSession[]

  @@index([preparationId, version])
}

model PlannedSession {
  id           String        @id @default(cuid())
  planId       String
  plan         StudyPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  durationMin  Int
  kind         SessionKind
  topicId      String
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  part         Int           @default(1)
  partCount    Int           @default(1)
  reviewNumber Int?
  status       PlannedStatus @default(PENDING)
  order        Int           @default(0)

  studySession StudySession?

  @@index([planId, date])
  @@index([topicId])
}

model StudySession {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedSessionId String?         @unique
  plannedSession   PlannedSession? @relation(fields: [plannedSessionId], references: [id], onDelete: SetNull)
  topicId          String
  topic            Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  kind             SessionKind
  studyTextId      String?
  studyText        StudyText?      @relation(fields: [studyTextId], references: [id], onDelete: SetNull)
  questionIds      String[]
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  minutesSpent     Int?
  /// Nota da última tentativa e a melhor (0 a 1). A próxima aula só libera com PASS_SCORE.
  lastScore        Float?
  bestScore        Float?
  tries            Int             @default(0)
  passedAt         DateTime?
  /// Início da tentativa atual (refazer a aula começa uma nova rodada de respostas).
  roundStartedAt   DateTime        @default(now())

  @@index([userId, startedAt])
}

/// Texto de estudo gerado pela IA; cache por tópico + parte + tipo de estudante.
model StudyText {
  id            String      @id @default(cuid())
  topicId       String
  topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  part          Int
  partCount     Int
  studentType   StudentType
  content       String
  highlights    Json
  keyPoints     Json
  sourceRefs    Json
  promptVersion String
  createdAt     DateTime    @default(now())

  studySessions StudySession[]
  questions     Question[]

  @@unique([topicId, part, partCount, studentType, promptVersion])
}

// ───────────────────────── Questões e aprendizagem ─────────────────────────

enum QuestionType {
  MULTIPLE_CHOICE
  CERTO_ERRADO
  OPEN_RECALL
}

model Question {
  id            String       @id @default(cuid())
  topicId       String
  topic         Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  studyTextId   String?
  studyText     StudyText?   @relation(fields: [studyTextId], references: [id], onDelete: SetNull)
  type          QuestionType
  statement     String
  options       Json?
  correctAnswer String
  explanation   String
  /// Aula curta (gerada sob demanda no banco de erros) explicando a resposta certa com base no material.
  lesson        String?
  difficulty    Int          @default(3)
  sourceRefs    Json         @default("[]")
  createdAt     DateTime     @default(now())

  attempts    Attempt[]
  reviewItems ReviewItem[]

  @@index([topicId])
}

enum AttemptContext {
  SESSION
  REVIEW
  ERROR_BANK
  GAME
  EXAM
}

model Attempt {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  context    AttemptContext
  contextId  String?
  answer     String
  isCorrect  Boolean
  score      Float
  feedback   String?
  timeMs     Int?
  createdAt  DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([questionId])
}

/// Repetição por questão: erros (banco de erros) voltam logo, acertos voltam com menos frequência.
model ReviewItem {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  step         Int       @default(0)
  dueAt        DateTime  @db.Date
  lapses       Int       @default(0)
  correctCount Int       @default(0)
  lastResult   Boolean
  inErrorBank  Boolean   @default(false)
  resolvedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, questionId])
  @@index([userId, dueAt])
}

/// Revisão espaçada do assunto (R1, R2, R3, R4...).
model TopicReview {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reviewNumber Int
  dueDate      DateTime  @db.Date
  doneAt       DateTime?

  @@unique([userId, topicId, reviewNumber])
  @@index([userId, dueDate])
}

enum MasteryStatus {
  SEM_DADOS
  CRITICO
  EM_DESENVOLVIMENTO
  BOM
}

model TopicMastery {
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts  Int           @default(0)
  correct   Float         @default(0)
  accuracy  Float         @default(0)
  status    MasteryStatus @default(SEM_DADOS)
  studyDone Boolean       @default(false)
  updatedAt DateTime      @updatedAt

  @@id([userId, topicId])
}

// ───────────────────────── Gamificação básica ─────────────────────────

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model StudyDay {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  minutes Int      @default(0)

  @@id([userId, date])
}

// ───────────────────────── Assinatura, limites e custo de IA ─────────────────────────

enum BillingInterval {
  WEEK
  MONTH
}

/// Níveis de plano (grátis, essencial, completo, intensivo). Preços e limites são editáveis no /admin.
model Plan {
  slug            String  @id
  name            String
  order           Int     @default(0)
  priceWeekCents  Int     @default(0)
  priceMonthCents Int     @default(0)
  /// Limites do plano (ver PlanLimits em src/lib/plans.ts). -1 = ilimitado.
  limits          Json    @default("{}")
  active          Boolean @default(true)

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planSlug               String
  plan                   Plan               @relation(fields: [planSlug], references: [slug])
  provider               String
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  status                 SubscriptionStatus
  interval               BillingInterval    @default(MONTH)
  billingType            BillingType
  /// Fim do período já pago. O acesso vale até esta data (mesmo após cancelar).
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  payments Payment[]

  @@index([userId, status])
}

enum BillingType {
  PIX
  CREDIT_CARD
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELED
}

model Payment {
  id                String        @id @default(cuid())
  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  providerPaymentId String        @unique
  status            PaymentStatus
  billingType       BillingType
  valueCents        Int
  dueDate           DateTime      @db.Date
  paidAt            DateTime?
  invoiceUrl        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([subscriptionId, dueDate])
}

/// Eventos recebidos do provedor de pagamento (idempotência e auditoria).
model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model UsageCounter {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric      String
  periodStart DateTime @db.Date
  count       Int      @default(0)

  @@id([userId, metric, periodStart])
}

model AiUsage {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  task            String
  model           String
  inputTokens     Int
  outputTokens    Int
  cacheReadTokens Int      @default(0)
  costMicros      Int
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

/// Cache genérico de respostas da IA (mesma entrada = mesma resposta, sem nova chamada).
model AiCache {
  key       String   @id
  task      String
  value     Json
  createdAt DateTime @default(now())
}

// ───────────────────────── Fase 2: jogos, simulados, redação, Professor IA ─────────────────────────

model GameRun {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  preparationId String
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  gameSlug      String
  /// Nome dado pelo aluno ao teste rápido (ex.: "Teste 3").
  name          String?
  topicIds      String[]
  questionIds   String[]
  config        Json        @default("{}")
  score         Int         @default(0)
  correct       Int         @default(0)
  wrong         Int         @default(0)
  avgTimeMs     Int?
  endedReason   String?
  startedAt     DateTime    @default(now())
  endedAt       DateTime?

  @@index([userId, gameSlug, startedAt])
}

enum ExamStyle {
  MULTIPLE_CHOICE
  CERTO_ERRADO
}

model Exam {
  id            String      @id @default(cuid())
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  preparationId String
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  title         String
  style         ExamStyle
  durationMin   Int
  subjectIds    String[]
  questionIds   String[]
  createdAt     DateTime    @default(now())

  attempts ExamAttempt[]

  @@index([ownerId, createdAt])
}

model ExamAttempt {
  id           String    @id @default(cuid())
  examId       String
  exam         Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      Json      @default("{}")
  startedAt    DateTime  @default(now())
  deadline     DateTime
  finishedAt   DateTime?
  correct      Int?
  total        Int?
  score        Float?
  perSubject   Json?
  timeSpentSec Int?

  @@index([userId, startedAt])
}

enum EssayRubric {
  ENEM
  DISCURSIVA
  GERAL
}

enum EssayStatus {
  DRAFT
  EVALUATING
  EVALUATED
  ERROR
}

model Essay {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  preparationId String?
  preparation   Preparation? @relation(fields: [preparationId], references: [id], onDelete: SetNull)
  rubric        EssayRubric
  theme         String
  instructions  String?
  text          String
  /// Tempo escolhido pelo aluno para escrever (10, 30, 60 ou 180 min).
  timeLimitMin  Int?
  status        EssayStatus  @default(DRAFT)
  score         Float?
  maxScore      Float?
  evaluation    Json?
  createdAt     DateTime     @default(now())
  evaluatedAt   DateTime?

  @@index([userId, createdAt])
}

model TutorThread {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preparationId String
  preparation   Preparation   @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  title         String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  messages TutorMessage[]

  @@index([userId, updatedAt])
}

model TutorMessage {
  id         String      @id @default(cuid())
  threadId   String
  thread     TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       String
  content    String
  sourceRefs Json        @default("[]")
  createdAt  DateTime    @default(now())

  @@index([threadId, createdAt])
}

// ───────────────────────── Fase 3: grupos, conquistas, notificações ─────────────────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  /// Código para entrar no grupo (ex.: K7M2QX).
  code        String   @unique
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members     GroupMember[]
  invites     GroupInvite[]
  tournaments Tournament[]
  shares   GroupShare[]
  messages GroupMessage[]
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model GroupMember {
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

model GroupInvite {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User         @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String
  invitee     User         @relation("invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@index([inviteeId, status])
  @@index([groupId, status])
}

enum ShareType {
  MATERIAL
  SUMMARY
  QUESTION_SET
  EXAM
}

model GroupShare {
  id         String    @id @default(cuid())
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sharedById String
  sharedBy   User      @relation(fields: [sharedById], references: [id], onDelete: Cascade)
  type       ShareType
  resourceId String
  title      String
  createdAt  DateTime  @default(now())

  @@unique([groupId, type, resourceId])
  @@index([type, resourceId])
}

model GroupMessage {
  id        String    @id @default(cuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([groupId, createdAt])
}

model UserAchievement {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug       String
  unlockedAt DateTime @default(now())

  @@id([userId, slug])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  /// Evita avisos repetidos (ex.: lembrete:prepId:2026-10-01).
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

// ───────────────────────── Site e suporte ─────────────────────────

/// Configurações do site editáveis no /admin (ex.: links das redes sociais do rodapé).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum TicketStatus {
  OPEN
  CLOSED
}

/// Chamado de suporte: o aluno abre com um tipo; a equipe responde e finaliza (depois disso não aceita mensagens).
model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tipo escolhido pelo aluno (dúvida, problema, pagamento...).
  kind      String
  status    TicketStatus     @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  closedAt  DateTime?
  messages  SupportMessage[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

/// Mensagem de um chamado de suporte.
model SupportMessage {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// true = resposta da equipe; false = mensagem do aluno.
  fromStaff Boolean   @default(false)
  body      String
  /// Quando a outra parte leu (o aluno lê as respostas; a equipe lê as mensagens).
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([ticketId, createdAt])
  @@index([fromStaff, readAt])
}

/// Registro de cada preparação (guia de estudo) criada: o limite do plano é por mês e não volta ao apagar.
model PreparationCreation {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Torneio do grupo: ranking de XP dos membros entre o início e o fim.
model Tournament {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  startsAt    DateTime @default(now())
  endsAt      DateTime
  createdById String
  createdAt   DateTime @default(now())

  @@index([groupId, endsAt])
}
