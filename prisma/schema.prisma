// HoraLimp — marketplace de profissionais de limpeza residencial.
// Cliente usa de graça; o profissional paga a assinatura mensal (R$ 15,85). A limpeza é paga direto ao profissional.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Contas (Better Auth + campos da HoraLimp) ─────────────────────────

enum Role {
  CLIENT
  PRO
  ADMIN
}

model User {
  id            String   @id
  name          String
  /// e-mail técnico interno exigido pelo Better Auth (derivado de um código aleatório; nunca exibido nem usado para envio)
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role      Role      @default(CLIENT)
  /// CPF guardado de dois jeitos: código (HMAC) para login e para impedir CPF repetido, e criptografado (AES-GCM).
  cpfHash   String    @unique
  cpfSealed String
  /// conta bloqueada pelo admin (não entra)
  blockedAt DateTime?
  blockReason String?
  acceptedTermsAt DateTime @default(now())

  sessions      Session[]
  accounts      Account[]
  pro           ProfessionalProfile?
  addresses     Address[]
  clientBookings Booking[]          @relation("ClientBookings")
  favorites     Favorite[]         @relation("FavoriteClient")
  messages      Message[]
  reviewsGiven  Review[]           @relation("ReviewAuthor")
  reviewsGot    Review[]           @relation("ReviewTarget")
  reports       Report[]           @relation("Reporter")
  reportedIn    Report[]           @relation("Reported")
  blocks        Block[]            @relation("Blocker")
  blockedBy     Block[]            @relation("Blocked")
  tickets       SupportTicket[]
  notifications Notification[]
  pushSubs      PushSubscription[]
  statusChanges BookingStatusHistory[]
  auditLogs     AuditLog[]
  resets        PasswordReset[]

  @@index([role, createdAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Link de troca de senha gerado pelo admin depois de confirmar a identidade no suporte (a conta não tem e-mail).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String
  createdAt DateTime  @default(now())
}

// ───────────────────────── Profissional ─────────────────────────

enum ProStatus {
  INCOMPLETE
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model ProfessionalProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate   DateTime  @db.Date
  /// WhatsApp (só dígitos, criptografado): só a HoraLimp vê; nunca aparece para clientes
  whatsappSealed String
  photoKey    String?
  bio         String?
  /// preço por hora em centavos (livre; definido pelo profissional)
  hourlyCents Int?
  services    String[]
  status      ProStatus @default(INCOMPLETE)
  statusReason String?
  /// pausa novas solicitações (continua com as já aceitas)
  paused      Boolean   @default(false)
  ratingSum   Int       @default(0)
  ratingCount Int       @default(0)
  completedCount Int    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  areas        ServiceArea[]
  availability AvailabilityRule[]
  bookings     Booking[]
  favoritedBy  Favorite[]
  subscription Subscription?
  payments     SubscriptionPayment[]
  approvals    ProfessionalApproval[]

  @@index([status])
}

/// Município onde o profissional atende (UF + nome, da lista oficial).
model ServiceArea {
  id    String              @id @default(cuid())
  proId String
  pro   ProfessionalProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  uf    String
  city  String

  @@unique([proId, uf, city])
  @@index([uf, city])
}

/// Horário de atendimento: dia da semana (0 = domingo) e faixa em minutos desde 0h.
model AvailabilityRule {
  id       String              @id @default(cuid())
  proId    String
  pro      ProfessionalProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int

  @@index([proId, weekday])
}

/// Histórico da verificação (quem aprovou/reprovou/suspendeu e por quê).
model ProfessionalApproval {
  id        String              @id @default(cuid())
  proId     String
  pro       ProfessionalProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  status    ProStatus
  reason    String?
  adminId   String?
  createdAt DateTime            @default(now())

  @@index([proId, createdAt])
}

// ───────────────────────── Assinatura do profissional (R$ 15,85/mês, Pix SyncPay) ─────────────────────────

model Subscription {
  id               String              @id @default(cuid())
  proId            String              @unique
  pro              ProfessionalProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  /// assinatura vale até aqui (vencida = fora da vitrine)
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model SubscriptionPayment {
  id          String              @id @default(cuid())
  proId       String
  pro         ProfessionalProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  amountCents Int
  status      PaymentStatus       @default(PENDING)
  /// "SYNCPAY" (Pix) ou "MANUAL" (liberado pelo admin)
  provider    String              @default("SYNCPAY")
  providerId  String?             @unique
  pixCode     String?
  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([proId, createdAt])
  @@index([status, createdAt])
}

/// Avisos (webhooks) recebidos: guardados uma vez só (idempotência) e para auditoria.
model ProviderEvent {
  id        String   @id @default(cuid())
  provider  String
  eventKey  String   @unique
  payload   Json
  createdAt DateTime @default(now())
}

// ───────────────────────── Contratação ─────────────────────────

model Address {
  id         String    @id @default(cuid())
  clientId   String
  client     User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label      String
  cep        String?
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  uf         String
  lat        Float?
  lng        Float?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([clientId, lastUsedAt])
}

enum BookingStatus {
  DRAFT
  READY
  WAITING_PRO
  ACCEPTED
  REFUSED
  EXPIRED
  ON_THE_WAY
  ARRIVED
  STARTED
  COMPLETED
  CANCELED_CLIENT
  CANCELED_PRO
  IN_REVIEW
}

/// Solicitação e contratação (vira contratação quando o profissional aceita).
model Booking {
  id           String              @id @default(cuid())
  clientId     String
  client       User                @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  proId        String
  pro          ProfessionalProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  status       BookingStatus       @default(WAITING_PRO)
  services     String[]
  hours        Int
  scheduledAt  DateTime
  /// preço por hora no momento do pedido (centavos) e o valor estimado = preço × horas (pago direto ao profissional)
  hourlyCents  Int
  estimateCents Int
  notes        String?
  homeSize     String?
  rooms        Int?
  // endereço (só cliente, profissional que aceitou e admin veem)
  addrStreet     String
  addrNumber     String?
  addrComplement String?
  addrDistrict   String?
  addrCity       String
  addrUf         String
  addrCep        String?
  addrReference  String?
  lat            Float?
  lng            Float?
  /// forma de pagamento declarada (a HoraLimp não processa): CASH ou PIX
  payMethod    String?
  expiresAt    DateTime?
  acceptedAt   DateTime?
  completedAt  DateTime?
  canceledAt   DateTime?
  cancelReason String?
  /// endereço apagado depois do prazo (privacidade)
  addressPurgedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  history  BookingStatusHistory[]
  messages Message[]
  reviews  Review[]
  reports  Report[]

  @@index([clientId, createdAt])
  @@index([proId, status, scheduledAt])
  @@index([status, expiresAt])
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  from      BookingStatus?
  to        BookingStatus
  byUserId  String?
  by        User?         @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  reason    String?
  createdAt DateTime      @default(now())

  @@index([bookingId, createdAt])
}

enum MessageKind {
  TEXT
  AUDIO
  IMAGE
}

model Message {
  id         String      @id @default(cuid())
  bookingId  String
  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind       MessageKind
  text       String?
  fileKey    String?
  mime       String?
  durationSec Int?
  readAt     DateTime?
  createdAt  DateTime    @default(now())

  @@index([bookingId, createdAt])
}

model Favorite {
  clientId  String
  client    User                @relation("FavoriteClient", fields: [clientId], references: [id], onDelete: Cascade)
  proId     String
  pro       ProfessionalProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@id([clientId, proId])
}

model Review {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User      @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String?
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([bookingId, authorId])
  @@index([targetId, createdAt])
}

// ───────────────────────── Segurança, suporte e avisos ─────────────────────────

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String?
  target     User?        @relation("Reported", fields: [targetId], references: [id], onDelete: SetNull)
  bookingId  String?
  booking    Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messageId  String?
  reviewId   String?
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

model Block {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  bookingId String?
  status    TicketStatus     @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean       @default(false)
  authorId  String
  text      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// Configurações da plataforma (valor JSON), editadas no admin.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
